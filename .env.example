# Filesystem path to the SQLite database file
DB_PATH=./data/app.db

# Base URL used when composing full short links in API responses
BASE_URL=http://localhost:8000

# Length of auto-generated short codes
CODE_LENGTH=7

# Max accepted length of a submitted URL
MAX_URL_LENGTH=2048

# Application log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Port the server binds to (used by Docker / App Platform)
PORT=8000
